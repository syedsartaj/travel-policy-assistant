# Every value here is OPTIONAL. With no environment at all the assistant runs
# fully offline: no API key, no account, no network, no model download.
#
# To use this file:  node --env-file=.env src/cli.ts "..."   (Node 20.6+)
# or export the variables yourself. Copy it to .env, which git ignores.

# Which language model backs the answer phrasing. "offline" is the default.
#   offline   deterministic, no network, no credentials  (default)
#   anthropic calls the Anthropic Messages API; requires ANTHROPIC_API_KEY
MODEL_PROVIDER=offline

# Only read when MODEL_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Override the policy file. Defaults to data/travel_expense_policy.csv
# in the package root.
# POLICY_FILE=./data/travel_expense_policy.csv
